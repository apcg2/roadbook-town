{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roadbook Town trip v2",
  "type": "object",
  "required": [
    "version",
    "id",
    "title",
    "startDate",
    "endDate",
    "places",
    "stops"
  ],
  "$defs": {
    "reviewItems": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["text", "sentiment", "sourceType", "sourceIds"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 5},
          "sentiment": {"enum": ["positive", "neutral", "negative"]},
          "sourceType": {"enum": ["post", "comment"]},
          "sourceIds": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}}
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "demo": {
      "type": "boolean"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "endDate": {
      "type": "string",
      "format": "date"
    },
    "provinces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "city",
          "address",
          "kind",
          "gcj02"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "city",
              "poi",
              "area"
            ]
          },
          "gcj02": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "wgs84": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "verified": {
            "type": "boolean"
          },
          "poiId": {
            "type": "string"
          },
          "canonicalAttractionId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      }
    },
    "stops": {
      "type": "array",
      "minItems": 2,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "placeId",
          "arrive",
          "leave",
          "events"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "role": {
            "enum": [
              "start",
              "visit",
              "end"
            ]
          },
          "placeId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "arrive": {
            "type": "string",
            "format": "date"
          },
          "leave": {
            "type": "string",
            "format": "date"
          },
          "art": {
            "enum": [
              "town",
              "mountains",
              "lake",
              "cave",
              "river",
              "village",
              "hamlet",
              "bridge",
              "skyline",
              "arcade"
            ]
          },
          "foods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "sourceIds"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  }
                }
              }
            }
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type",
                "date",
                "period",
                "placeId"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "arrive",
                    "depart",
                    "play",
                    "stay"
                  ]
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "period": {
                  "enum": [
                    "早上",
                    "上午",
                    "中午",
                    "下午",
                    "傍晚",
                    "晚上"
                  ]
                },
                "placeId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "text": {
                  "type": "string"
                },
                "summary": {
                  "type": "string",
                  "maxLength": 15
                },
                "minutes": {
                  "type": "number",
                  "minimum": 0
                },
                "duration": {
                  "type": "string"
                },
                "reviews": {
                  "type": "object",
                  "required": ["status", "research"],
                  "properties": {
                    "status": {"enum": ["supported", "insufficient", "pending"]},
                    "reasonCode": {"enum": ["provider-unavailable", "author-shortfall", "limitation-shortfall", "irrelevant-results", "non-advertorial-shortfall"]},
                    "reason": {"type": "string"},
                    "research": {
                      "type": "object",
                      "required": ["status", "attempts", "candidateCount", "acceptedCount", "authorCount"],
                      "properties": {
                        "status": {"enum": ["pending", "complete"]},
                        "attempts": {"type": "array"},
                        "candidateCount": {"type": "integer", "minimum": 0},
                        "acceptedCount": {"type": "integer", "minimum": 0},
                        "authorCount": {"type": "integer", "minimum": 0}
                      }
                    },
                    "positive": {"$ref": "#/$defs/reviewItems"},
                    "limitations": {"$ref": "#/$defs/reviewItems"}
                  }
                },
                "hotel": {
                  "type": "object",
                  "required": [
                    "name",
                    "placeId"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "placeId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "play"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "summary",
                      "minutes",
                      "duration",
                      "reviews"
                    ]
                  }
                }
              ]
            }
          },
          "entryPlaceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "sightShortfallReason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "visit"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "properties": {
                "foods": {
                  "minItems": 5,
                  "maxItems": 5
                }
              }
            },
            "else": {
              "properties": {
                "foods": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "provider": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "accepted": {
            "type": "boolean"
          },
          "authorRef": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "evidenceType": {
            "enum": ["post", "comment"]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "provider",
        "inputHash",
        "legs"
      ],
      "properties": {
        "provider": {
          "enum": [
            "amap",
            "synthetic"
          ]
        },
        "inputHash": {
          "type": "string"
        },
        "queriedAt": {
          "type": "string"
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "distanceM",
              "durationS",
              "points"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "distanceM": {
                "type": "number",
                "minimum": 0
              },
              "durationS": {
                "type": "number",
                "minimum": 0
              },
              "points": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "planHash": {
          "type": "string"
        },
        "confirmedAt": {
          "type": "string"
        }
      }
    }
  }
}
